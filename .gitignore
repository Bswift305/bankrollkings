# Local secrets
.env
.env.*
!.env.example

# Local-only attic: stray exports/docs/logs/archives moved out of the repo root
# to keep production code uncluttered. Never deployed; safe to delete locally.
/_attic/

# SSH / private keys — never commit
*.pem
*.key
*.ppk
id_ed25519
id_rsa

# Stripe / API secret-bearing files — never commit (e.g. sk_live_*.txt)
sk_live_*
sk_test_*
*secret*.txt

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime logs and server output
logs/
.runtime/
*.log
server*.out.txt
server*.err.txt

# Local assistant/editor state
.claude/

# Generated app data and bulky local datasets
data/cache/
data/debug/
data/franchise/
data/franchise_leagues/
data/gamelogs/
# Contents-glob rather than the bare directory: git will not descend into an
# excluded directory, so a `!` exception below would never be reachable.
data/historical/*
data/injuries/
data/live_scores/
data/odds/
data/props/
data/rosters/
data/schedules/
data/tracking/
data/user_notes/

# Local exports, spreadsheets, docs, archives
*.zip
*.xlsx
*.xls
*.docx
*.pptx
*.csv
*.lnk

# Raw local asset dumps; app-ready assets live under static/
# Leading slash anchors this to the repo root ONLY — without it, a
# case-insensitive (Windows/macOS) filesystem also matches static/logos/
# and silently drops the sidebar league logos from the repo.
/Logos/
/icons/New Icons.png

# Keep intentional repo seed/config CSVs, not generated slate context
!data/context/MLB_BallparkFactors.csv
data/context/MLB_GameContext.csv

# Keep the NFL historical prop lab. NFL_Props_History.csv was bought from The
# Odds API's billed historical endpoints and cannot be regenerated for free; the
# two schedule files are what the backfill joins it against. These live under an
# ignored directory, so the deploy never carried them, and prod's NFL calibration
# pipeline crashed on the missing input the moment NFL props went live
# (2026-09-09). Shipping them lets any fresh checkout rebuild the NFL lab itself.
# Must sit after the blanket *.csv rule above, or that rule wins.
!data/historical/NFL_Props_History.csv
!data/historical/NFL_Games_nfldata.csv
!data/historical/NFL_Games_2025_from_pbp.csv

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Franchise Kings user-uploaded GM photos (UGC, not source)
static/franchise_avatars/

# Local NFL play-by-play source (regenerable; prod serves the JSON export only)
data/pbp/*.parquet
