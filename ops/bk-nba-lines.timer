[Unit]
Description=Bankroll Kings - fire the NBA game-lines refresh every 4 hours

# PROPOSAL ONLY -- NOT installed or enabled by the repo.
#
# TIMER-ENABLEMENT BLOCKER: this 4h timer must NOT be enabled until an independent, legally approved NBA
# schedule source (or another reviewed no-game contract) exists. Today services/nba_schedule_authority.py
# has no authoritative source, so every provider-empty answer (a real no-game day included) is
# SCHEDULE_UNAVAILABLE -- an alerting, fail-closed failure. That fail-closed behaviour is accepted in code
# and must NEVER be "fixed" by fabricating NO_GAMES_SCHEDULED; enabling this timer first would simply page
# six times on every NBA off-day. See docs/game_lines_event_contract.md "Timer-enablement blocker".

[Timer]
# Times are UTC (prod's clock): 00:15, 04:15, 08:15, 12:15, 16:15, 20:15.
#  * Every 4h keeps a published slate inside the 6h executable-price rule (LIVE_LINES_MAX_AGE_HOURS) with
#    ~2h headroom; one missed tick lets lines go honestly stale at 6h rather than silently old.
#  * :15 past every fourth hour. The 12:15 tick finishes 45 min before bk-daily's 13:00 UTC start, so
#    bk-daily's NBA step REUSES it (REUSED_FRESH, zero credits) when it is <= 90 min old (duplicate-fetch
#    suppression only; customers still see the 6h rule), else fetches. Any overlap is serialized by the
#    shared kernel lock: bk-daily waits up to 120 s, re-reads the receipt + hashes under the lock
#    (REUSED_FRESH_AFTER_LOCK) or fetches; this job does not wait and exits 75 SKIPPED_LOCKED with no
#    request and no write.
#  * 20:15 UTC = 3:15/4:15 pm ET, ahead of the evening tip-offs.
# Cost: 6 runs/day x 3 credits = 18 credits/day (bk-daily's NBA fetch is usually reused).
OnCalendar=*-*-* 00/4:15:00
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
