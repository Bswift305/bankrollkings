[Unit]
Description=Bankroll Kings - NBA player props every 4h, 30 min after lines (own publisher lock; five-day window)
After=network-online.target
Wants=network-online.target

# PROPOSAL ONLY -- NOT installed or enabled by the repo.
#
# TIMER-ENABLEMENT BLOCKER (same as bk-nba-lines): do NOT enable bk-nba-props.timer until (1) an independent,
# legally approved NBA schedule source (or another reviewed no-game contract) exists -- until then the lines
# job it depends on is SCHEDULE_UNAVAILABLE on every off-day, and props would follow as
# SKIPPED_BLOCKED_BY_LINES; that fail-closed behaviour must never be replaced by a fabricated
# NO_GAMES_SCHEDULED -- and (2) production activation is separately authorized. Enable only together with,
# and after, bk-nba-lines.timer. See docs/game_lines_event_contract.md "NBA props cadence contract".
#
# What it runs: the same entry as bk-daily's NBA props step (fetch_player_props.main ->
# services.nba_props_publisher.publish): the props lock (nba_player_props.lock, its own, 0700/0600 under the
# runtime root) before any request, the lines-event-list prerequisite (a receipt-verified lines publish
# <= 120 min old), then /events (free) + one /events/{id}/odds per event in the FIVE-day window (6 markets,
# region us; billed per market returned). It never reuses (it IS the props refresh) and never waits.
#
# Install (via SSM as root, only after the blocker is cleared and activation is authorized):
#   sudo install -d -o ubuntu -g ubuntu -m 700 /opt/bankrollkings-runtime/locks   (shared with lines)
#   sudo cp ops/bk-nba-props.service /etc/systemd/system/bk-nba-props.service
#   sudo cp ops/bk-nba-props.timer   /etc/systemd/system/bk-nba-props.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now bk-nba-props.timer
# Remove:  sudo systemctl disable --now bk-nba-props.timer && sudo rm /etc/systemd/system/bk-nba-props.*

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bankrollkings
EnvironmentFile=/opt/bankrollkings/.env
ExecStart=/opt/bankrollkings/venv/bin/python fetch_player_props.py --sport basketball_nba --bookmakers draftkings,caesars,fanduel,betmgm --days 5 --caller nba_props_4h
# ~one HTTP call per event in the five-day window; no lock wait for this job.
TimeoutStartSec=600
# Exit codes are honest and NOT masked: 1 = failed / SKIPPED_BLOCKED_BY_LINES, 75 = SKIPPED_LOCKED,
# 76 = LOCK_UNAVAILABLE. Each marks the unit failed so it is visible; the timer keeps firing.
